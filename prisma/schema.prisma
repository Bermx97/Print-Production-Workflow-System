generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model order {
  id           String       @id @default(uuid())
  order_number Int          @unique
  due_date     DateTime
  created_by   String
  createdBy    employee     @relation("CreatedOrders", fields: [created_by], references: [id])
  product_type product_type
  quantity Int
  customer String
  number_of_pages Int
  step_quantities Json?
  step_logs step_logs[]
  order_parts order_parts[]
  step_execution step_execution[]
}

model employee {
  id              String        @id @default(uuid())
  login           String        @unique @db.VarChar(20)
  hashed_password String
  role            employee_role
  createdOrders   order[]       @relation("CreatedOrders")
  step_logs step_logs[]
}

model step_logs {
  id         String           @id @default(uuid())
  step_name  step_name
  order_id   String
  order_part_id  String?

  event_type step_event_type
  created_at DateTime @default(now())
  employee   String

  order      order     @relation(fields: [order_id], references: [id])
  employeeRel employee  @relation(fields: [employee], references: [id])
  order_part     order_parts?  @relation(fields: [order_part_id], references: [id])


  @@index([order_id])
  @@index([step_name])
  @@index([created_at])
}

model order_parts {
  id        String @id @default(uuid())

  order_id  String
  order     order @relation(fields: [order_id], references: [id])

  variant   Variant
  runs      Int
  part_quantity  Int
  step_execution step_execution[]
  step_logs     step_logs[]
}

model step_execution {
  id             String      @id @default(uuid())
  order_part_id  String?
  order_id       String

  step_type      step_name
  step_scope     step_scope

  done_quantity  Int?
  started_at   DateTime?
  finished_at  DateTime?
  status         execution_status
  order_part     order_parts? @relation(fields: [order_part_id], references: [id])
  order          order       @relation(fields: [order_id], references: [id])
  created_at     DateTime @default(now())
}

enum step_scope {
  per_part
  per_order
  aggregated
}

enum employee_role {
  printer_operator
  folding_operator
  sewing_operator
  case_maker
  hardcover_binder_operator
  perfect_bound_operator
  stitching_operator


  seller

  technologist
  admin
}

enum product_type {
  hardcover_book
  perfect_bound_book
  saddle_stitching
}

enum step_event_type {
  START
  END
  PAUSE
  RESUME
}

enum step_name {
  printing
  folding
  sewing
  case_making
  folding_with_milling
  hardcover_binding
  binding
  stitching
}

enum Variant {
  V4
  V8
  V16
  V24
  V32
  V64
}


enum execution_status {
  active
  paused
  done
  cancelled
}
