generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model order {
  id           String       @id @default(uuid())
  order_number Int          @unique
  due_date     DateTime
  created_by   String
  createdBy    employee     @relation("CreatedOrders", fields: [created_by], references: [id])
  product_type product_type
  quantity Int
  customer String
  number_of_pages Int
  step_quantities Json?
  step_logs step_logs[]
}

model employee {
  id              String        @id @default(uuid())
  login           String        @unique @db.VarChar(20)
  hashed_password String
  role            employee_role
  createdOrders   order[]       @relation("CreatedOrders")
  step_logs step_logs[]
}

model step_logs {
  id         String           @id @default(uuid())
  step_name  step_name
  order_id   String
  event_type step_event_type
  created_at DateTime @default(now())
  employee   String

  order      order     @relation(fields: [order_id], references: [id])
  employeeRel employee  @relation(fields: [employee], references: [id])

  @@index([order_id])
  @@index([step_name])
  @@index([created_at])
}

enum employee_role {
  printer_operator
  folding_operator
  sewing_operator
  case_maker
  hardcover_binder_operator
  perfect_bound_operator
  stitching_operator


  seller

  technologist
  admin
}

enum product_type {
  hardcover_book
  perfect_bound_book
  saddle_stitching
}

enum step_event_type {
  START
  END
  PAUSE
  RESUME
}

enum step_name {
  printing
  folding
  sewing
  case_making
  folding_with_milling
  hardcover_binding
  binding
  stitching
}